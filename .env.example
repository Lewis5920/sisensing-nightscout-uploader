# 硅基动感亲友分享 -> Nightscout 上传器 环境变量配置
# 复制此文件为 .env，填入实际值

# ===== 硅基 API 配置 =====
# 亲友关系 ID（从抓包获取，followRelationId 参数）
SI_FOLLOW_RELATION_ID=2088455721451631438
# 设备 ID（从抓包获取，deviceId 参数）
SI_DEVICE_ID=2095153918479945148
# 认证 Token（从抓包获取，Authorization 头中 Bearer 后面的部分，不含 Bearer）
SI_AUTH_TOKEN=c3217d8f-e448-4a6b-88e9-75d2e22f3247
# 应用代码（通常不用改）
SI_APP_CODE=SIJOY_HEALTH_APP

# ===== Nightscout 配置 =====
# Nightscout 网址
NS_URL=https://9FC3BAB952CCC1A8.abwsz.com
# Nightscout API-SECRET（网站登录密码的 SHA1 哈希）
# 计算方法：echo -n "你的密码" | sha1sum
NS_API_SECRET=1160a3a804ed9b811866fa081170667e267c2908

# ===== 轮询间隔（秒）=====
POLL_INTERVAL=300
